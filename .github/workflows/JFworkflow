name: Deploy Slots to GitHub Pages

on:
  push:
    branches:
      - J_EpicLightning

  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: pages
  cancel-in-progress: false

jobs:
  deploy:
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}

    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Pages
        uses: actions/configure-pages@v5

      - name: Upload Slots
        uses: actions/upload-pages-artifact@v3
        with:
          path: ./Slots

      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v5
